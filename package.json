{
  "name": "decky-steamachievements",
  "version": "0.2.1",
  "description": "Restores the achievement progress bar Valve removed from the Steam Deck game-details page.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "npm run build && node ./scripts/package.mjs",
    "package:linux": "npm run build && node ./scripts/package.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam",
    "steam-deck",
    "achievements"
  ],
  "author": "beallio",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/ui": "^4.7.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "happy-dom": "^20.11.6",
    "rollup": "^4.22.5",
    "rollup-plugin-external-globals": "0.11.0",
    "rollup-plugin-import-assets": "1.1.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
