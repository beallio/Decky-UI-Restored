#!/usr/bin/env bash
# Project quality gates. Invoked by orchestration/run-quality-gates from the repo
# root. Exit non-zero to fail the gate.
#
# Decky-SteamAchievements is a Decky Loader plugin:
#   - TypeScript/React frontend in src/*.tsx, built with rollup -> dist/
#   - a minimal Python backend: main.py (plus backend/*.py if present)
#
# The gate is a build + static check + Python unit test pass:
#   1. TypeScript type-check (tsc --noEmit) and rollup production build
#   2. Python backend byte-compile (syntax check) of main.py and backend/*.py
#   3. Python tests when tests/ exists
#   4. Build and validate the canonical plugin ZIP without rebuilding the frontend
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# Keep generated caches/installs outside Dropbox through the same environment
# contract used by direct contributor commands.
export TMPDIR="/tmp/Decky-SteamAchievements"
export XDG_CACHE_HOME="$TMPDIR/.cache"
export npm_config_cache="$TMPDIR/.npm"
export PYTHONPYCACHEPREFIX="$TMPDIR/__pycache__"
export UV_CACHE_DIR="$TMPDIR/.uv"
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME" "$npm_config_cache" "$PYTHONPYCACHEPREFIX" "$UV_CACHE_DIR"

# --- source metadata agreement ---------------------------------------------
python_bin="$(command -v python3 || command -v python)"
"$python_bin" scripts/check_source_metadata.py
"$python_bin" scripts/check_identity.py
"$python_bin" scripts/check_installer_bundle.py

# --- frontend: type-check + build -------------------------------------------
if [[ -f package.json ]]; then
  if [[ ! -d node_modules ]]; then
    npm ci
  fi

  # Type-check without emitting, then run the real rollup build.
  npx tsc --noEmit
  npm run build

  # Frontend unit tests. package.json declares vitest, so a stale or incomplete
  # node_modules must fail the gate instead of silently skipping this step.
  npm test
fi

# --- backend: Python syntax check -------------------------------------------
if [[ -f main.py ]]; then
  "$python_bin" -m py_compile main.py
  if [[ -d backend ]]; then
    # -r/--no-run-if-empty: an empty backend/ must be a no-op, not a py_compile
    # invocation with zero filenames (which errors and fails the gate).
    find backend -name "*.py" -print0 | xargs -0 -r "$python_bin" -m py_compile
  fi
fi

# --- backend: Python tests ---------------------------------------------------
# A tests/ directory can exist without holding any Python tests. Here it survives only as
# leftover __pycache__ from a deleted test file; the real suite is vitest under
# src/*.test.tsx. pytest exits 5 ("no tests collected") when it finds none, which fails
# the gate under `set -e` on a perfectly healthy tree. Only run it when a Python test
# file actually exists.
if [[ -d tests ]] && find tests \( -name 'test_*.py' -o -name '*_test.py' \) -print -quit | grep -q .; then
  uv run --with pytest -- pytest -q
fi

# --- package + archive validation -------------------------------------------
if [[ -f package.json ]]; then
  base_version="$("$python_bin" -c 'import json; print(json.load(open("package.json", encoding="utf-8"))["version"])')"
  node scripts/package.mjs --no-hash
  "$python_bin" scripts/validate_plugin_zip.py Decky-SteamAchievements.zip \
    --expected-version "$base_version"
  "$python_bin" scripts/check_backend_archive_parity.py Decky-SteamAchievements.zip \
    --project-root "$repo_root"
fi

# --- release version drift guard --------------------------------------------
if [[ -f package.json && -f scripts/version_guard.py ]]; then
  if [[ -z "${base_version:-}" ]]; then
    base_version="$("$python_bin" -c 'import json; print(json.load(open("package.json", encoding="utf-8"))["version"])')"
  fi
  "$python_bin" scripts/version_guard.py check-drift "$base_version"
fi

echo "quality-gates: OK"
